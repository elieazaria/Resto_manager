{
  "name": "resto-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @resto/api\" \"npm run dev -w @resto/web\"",
    "build": "npm run build -w @resto/web && npm run build -w @resto/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "migrate": "npm run cli -w @resto/api -- migrate",
    "create-admin": "npm run cli -w @resto/api -- create-admin",
    "import-excel": "npm run cli -w @resto/api -- import-excel"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
