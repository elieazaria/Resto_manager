# ───────────── Base de données ─────────────
# Supabase : Project Settings → Database → Connection string.
#  - Pour l'API (serveur long-running) : "Session pooler" (port 5432) ou "Direct connection".
#    Mot de passe = celui du projet. Rôle `postgres` obligatoire (il contourne RLS ; l'API est la seule à parler à la base).
#  - Ne PAS utiliser le "Transaction pooler" (6543) pour les migrations.
# Local (docker compose up db) : postgres://resto:resto@localhost:5432/resto

# `require` pour Supabase (TLS), `disable` pour Postgres local
DATABASE_URL=postgresql://postgres.yhgnfsfwtpbaklklrlzg:Tlmvpsp4724@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# ───────────── Sécurité ─────────────
# 32+ caractères aléatoires :  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Durée d'une session (un service ≈ 12h)
JWT_TTL=12h
# Poivre appliqué au PIN avant argon2 (recommandé en prod) :  openssl rand -base64 24
# PIN_PEPPER=
MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=5

# ───────────── Serveur ─────────────
PORT=3000
HOST=0.0.0.0
APP_TZ=Indian/Antananarivo
# Derrière un proxy (Fly, Render, Caddy) : true
TRUST_PROXY=true
# Origines CORS autorisées si le front est hébergé ailleurs (sinon vide : même origine)
CORS_ORIGINS=
# Servir le front compilé depuis l'API (une seule URL à déployer)
WEB_DIST=../web/dist
AUTO_MIGRATE=false

# Premier gérant créé au démarrage si aucun n'existe (à retirer ensuite)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMoi-123

# ───────────── Sauvegardes (scripts/backup) ─────────────
# Destination : s3://bucket/prefix (Cloudflare R2, Backblaze B2, AWS S3…) ou un dossier local
# BACKUP_DEST=s3://mon-bucket/resto
# BACKUP_RETENTION_DAYS=30
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_DEFAULT_REGION=auto
# Chiffrement optionnel avec age (clé publique) :
# BACKUP_AGE_RECIPIENT=age1...
